  "entry": [
    "app/features/pwa/offline-shell-entry.client.ts",
    "app/features/pwa/recovery-worker.ts",
    "app/features/pwa/service-worker.ts",
    "app/routes/**/*.{ts,tsx}",
    "scripts/pwa/build-artifacts.ts",
    "scripts/agent/seed.ts",
