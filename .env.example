# Copy to .env for local development. Prisma resolves `file:./data.db`
# relative to the schema directory (`prisma/`), so the DB lands at
# `prisma/data.db` regardless of cwd.
DATABASE_URL="file:./data.db"

# Comma-separated list of admin email addresses that `prisma db seed`
# should provision. Seed creates the admin user rows only; each admin
# still sets a password later through the "forgot password" flow.
ADMIN_SEED_EMAILS="admin@example.com, admin_2@example.com"

# Comma-separated list (first value signs, any value verifies) so we can
# rotate keys with zero downtime. Generate with `openssl rand -base64 32`.
SESSION_SECRET="test-session-secret-at-least-16-chars"
PASSWORD_RESET_SECRET="test-reset-secret-at-least-16-chars"

# Honeypot token salt - protects the spam field from trivially reversing.
HONEYPOT_SECRET="test-honeypot-secret-16c"

# Resend (https://resend.com). Required in production. In local dev this
# may be left empty - the app captures outgoing mail in the in-app dev
# inbox (`/dev/last-email`) instead of sending it.
RESEND_API_KEY=""

# Visible sender / From header for outbound mail. In production this
# should use an address/domain verified with your email provider.
EMAIL_FROM="Moj Dzemat <noreply@example.com>"

# Optional community label appended to the default UI brand. Example:
# "Donje Mostre" renders as "Moj Džemat - Donje Mostre".
DZEMAT_NAME=""

# Optional location block on the homepage. `DZEMAT_ADDRESS` is what the UI
# displays; `DZEMAT_MAP_QUERY` is what Google Maps searches/embeds. If
# `DZEMAT_MAP_QUERY` is empty, the app falls back to `DZEMAT_ADDRESS`.
DZEMAT_ADDRESS=""
DZEMAT_MAP_QUERY=""

# Optional official Facebook page. When empty, Facebook links are hidden.
FACEBOOK_PAGE_URL=""

# Optional Cloudflare Web Analytics token. When empty, the analytics script
# is not rendered. The script is only included on public HTML pages.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=""

# Public origin of the site, used to build absolute URLs (password reset,
# OG tags, sitemap). No trailing slash.
APP_URL="http://localhost:3000"

# Express port (overridden by Fly).
PORT="3000"

# Enables the /dev/last-email helper that Playwright reads to assert on
# outgoing mail. Leave unset / "false" in production.
ENABLE_TEST_ROUTES="false"

# Test-only override for browser automation. When true, the honeypot still
# verifies the hidden field + signature, but skips the minimum-age delay.
HONEYPOT_SKIP_MIN_AGE="false"

# Test-only override for browser automation. Leave "false" in production.
DISABLE_RATE_LIMITING="false"
