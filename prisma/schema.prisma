// moj-dzemat database schema.
//
// Single SQLite file replicated to Fly LiteFS. Images are stored as blobs
// (cap 3 per post, enforced in the action layer). Admin login is the only
// authenticated flow - public visitors never sign in, so there is no
// "Verification" model; password reset uses stateless signed URLs.
//
// Keep this file flat; no deeply nested optional structures that SQLite
// struggles to index.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---- Auth ---------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Password is its own row so we can rotate or revoke without touching
  // the user record. Optional because a seeded admin may exist before
  // the first-login password is chosen.
  password Password?
  sessions Session[]
  posts    Post[]
}

model Password {
  hash      String
  updatedAt DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

// Server-side session store. Cookie only holds the session id; every
// server request loads the row to resolve current user + expiry.
model Session {
  id             String   @id @default(cuid())
  expirationDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@index([userId])
  @@index([expirationDate])
}

// Canonical identifiers for the five post categories shown in the UI.
enum PostType {
  obavijest
  smrtovnica
  sergija
  hutba
  price
}

enum PostStatus {
  draft
  published
}

enum PostNotificationStatus {
  pending
  skipped
  completed
  cancelled
  expired
}

enum PushDeliveryStatus {
  pending
  sending
  retry
  sent
  failed
  cancelled
}

enum PushDeliveryResultCode {
  accepted
  timeout
  network_error
  temporary_response
  invalid_request
  payload_too_large
  vapid_rejected
  subscription_gone
  invalid_subscription
  expired
  cancelled
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  body        String
  type        PostType
  status      PostStatus @default(published)
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Editorial flags the admin flips from the dashboard. `featured` posts
  // surface in the hero carousel; `pinned` posts float to the top of the
  // grid within their current filter.
  featured Boolean @default(false)
  pinned   Boolean @default(false)

  // Draft-only editorial preference. The durable PostNotification marker
  // records the actual first-publication decision independently of this flag.
  notifyOnPublish Boolean @default(false)

  // Author is nullable: we keep the relation for audit but never render
  // it publicly, and admins may come/go without orphaning their posts.
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authorId String?

  images PostImage[]
  videos PostVideo[]

  @@index([status, publishedAt])
  @@index([status, type, publishedAt])
  @@index([status, featured, publishedAt])
  @@index([type, publishedAt])
  @@index([publishedAt])
  @@index([featured, publishedAt])
  @@index([pinned, publishedAt])
  @@index([authorId])
}

// Anonymous browser subscriptions. Secrets are kept together in one
// Compact JWE; only a one-way endpoint hash is queryable.
model PushSubscription {
  id                    Int       @id @default(autoincrement())
  endpointHash          String    @unique
  encryptedSubscription String
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  deliveries PushDelivery[]

  @@index([expiresAt])
}

// Immutable first-publication decision marker. postId deliberately has no
// foreign key so deletion cannot erase the fact that a decision was made.
model PostNotification {
  id                   String                 @id @default(cuid())
  postId               String                 @unique
  status               PostNotificationStatus
  skipReason           String?
  titleSnapshot        String
  resolverPathSnapshot String
  deadlineAt           DateTime
  completedAt          DateTime?
  cancelledAt          DateTime?
  expiredAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  deliveries PushDelivery[]

  @@index([status, deadlineAt])
}

model PushDelivery {
  id                   Int                     @id @default(autoincrement())
  notificationId       String
  subscriptionId       Int?
  endpointHashSnapshot String
  status               PushDeliveryStatus      @default(pending)
  attemptCount         Int                     @default(0)
  nextAttemptAt        DateTime                @default(now())
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  lastHttpStatus       Int?
  resultCode           PushDeliveryResultCode?
  sentAt               DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  notification PostNotification  @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subscription PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([notificationId, endpointHashSnapshot])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([subscriptionId])
}

// Up to three images per post (cap enforced in the action layer).
// Binary stored in the same file as metadata; sharp pre-resizes to
// WebP <= 2000px / 80% quality before we persist.
model PostImage {
  id          String   @id @default(cuid())
  contentType String
  altText     String?
  // SQLite BLOB; Prisma maps Bytes <-> Buffer.
  data        Bytes
  width       Int?
  height      Int?
  byteSize    Int
  createdAt   DateTime @default(now())
  position    Int      @default(0)

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postId String

  @@index([postId, position])
}

// External YouTube videos attached to a post; cap enforced in the write path.
model PostVideo {
  id         String   @id @default(cuid())
  provider   String
  providerId String
  url        String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postId String

  @@index([postId, position])
}

// Top-of-page announcement strip the admin can toggle active. We support
// a single active announcement in the app: activating one deactivates
// the rest, and the public layout reads the newest active row.
model SiteAnnouncement {
  id        String   @id @default(cuid())
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

model Question {
  id         String    @id @default(cuid())
  question   String
  answer     String?
  isHidden   Boolean   @default(false)
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([answer, isHidden, answeredAt])
  @@index([answer, createdAt])
  @@index([answeredAt])
}

// Upcoming community calendar dates (date-only). Admin manages all rows;
// the public home page shows only the next few upcoming entries. `date`
// is a DateTime pinned to UTC midnight of the calendar day and always read
// back via UTC extraction, so the displayed day never shifts with the
// server/browser timezone.
model ImportantDate {
  id           String   @id @default(cuid())
  title        String
  date         DateTime // UTC midnight of the calendar day (date-only)
  description  String?
  recursYearly Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

// Singleton contact / about page for the džemat. Always at most one row
// (`id = "default"`). Address and map stay on env branding; this model
// holds the editable community details (phone, bank details, imam, hours, etc.).
model CommunityInfo {
  id String @id @default("default")

  showAbout    Boolean @default(true)
  showContact  Boolean @default(true)
  showImam     Boolean @default(true)
  showBoard    Boolean @default(true)
  showBank     Boolean @default(true)
  showLocation Boolean @default(true)

  aboutText String?

  imamName  String?
  imamPhone String?
  imamEmail String?

  contactPhone String?
  contactEmail String?
  officeHours  String?

  bankAccount     String?
  bankBeneficiary String?
  bankName        String?
  bankSwift       String?
  bankNote        String?

  boardNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
