{
  "name": "moj-dzemat",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight community publishing app for Bosnian-Herzegovinian džemats: public posts, admin panel, SQLite + Fly.io.",
  "license": "MIT",
  "author": "Tajib Smajlović",
  "homepage": "https://github.com/TajibSmajlovic/moj-dzemat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TajibSmajlovic/moj-dzemat.git"
  },
  "bugs": {
    "url": "https://github.com/TajibSmajlovic/moj-dzemat/issues"
  },
  "imports": {
    "#app/*": "./app/*"
  },
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "NODE_ENV=production node build/server-entry.mjs",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run format:check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed",
    "knip": "knip",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "prisma migrate dev && prisma db seed",
    "postinstall": "react-router typegen && prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@conform-to/react": "^1.19.2",
    "@conform-to/zod": "^1.19.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "@isaacs/ttlcache": "^2.1.4",
    "@mjackson/form-data-parser": "^0.9.1",
    "@prisma/client": "^6.19.3",
    "@react-router/express": "7.15.0",
    "@react-router/fs-routes": "7.15.0",
    "@react-router/node": "7.15.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-text-align": "^3.23.1",
    "@tiptap/extension-typography": "^3.23.1",
    "@tiptap/extension-underline": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "isbot": "^5",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.15.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.1",
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.5.5",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "knip": "^6.12.2",
    "prettier": "^3.4.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
