{
  "name": "moj-dzemat",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight community publishing app for Bosnian-Herzegovinian džemats: public posts, admin panel, SQLite + Fly.io.",
  "license": "MIT",
  "author": "Tajib Smajlović",
  "homepage": "https://github.com/TajibSmajlovic/moj-dzemat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TajibSmajlovic/moj-dzemat.git"
  },
  "bugs": {
    "url": "https://github.com/TajibSmajlovic/moj-dzemat/issues"
  },
  "imports": {
    "#app/*": "./app/*",
    "#generated/*": "./generated/*",
    "#prisma/*": "./prisma/*"
  },
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "build": "node --import tsx scripts/build.ts",
    "build:e2e": "node --import tsx scripts/build.ts --include-dev-routes",
    "pwa:icons": "node --import tsx scripts/pwa/generate-icons.ts",
    "start": "NODE_ENV=production node build/server-entry.mjs",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node --import tsx scripts/checks/architecture.ts",
    "docs:check": "node --import tsx scripts/checks/docs.ts",
    "harness:check": "npm run docs:check && npm run architecture:check",
    "check": "npm run harness:check && npm run typecheck && npm run lint -- --max-warnings=0 && npm run format:check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node --import tsx scripts/run-e2e-tests.ts",
    "test:e2e:ui": "node --import tsx scripts/run-e2e-tests.ts --headed",
    "test:pwa": "node --import tsx scripts/pwa/run-tests.ts",
    "agent:start": "node --import tsx scripts/agent/runtime.ts start",
    "agent:logs": "node --import tsx scripts/agent/runtime.ts logs",
    "agent:stop": "node --import tsx scripts/agent/runtime.ts stop",
    "agent:verify": "npm run check && npm run knip && npm run test:run && npm run test:e2e && npm run test:pwa",
    "agent:gc": "node --import tsx scripts/agent/maintenance.ts",
    "knip": "knip --treat-config-hints-as-errors",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset && prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:setup": "prisma migrate dev && prisma generate && prisma db seed",
    "postinstall": "react-router typegen && prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@isaacs/ttlcache": "^2.1.4",
    "@mjackson/form-data-parser": "^0.9.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/express": "8.3.1",
    "@react-router/fs-routes": "8.3.1",
    "@react-router/node": "8.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-typography": "^3.30.5",
    "@tiptap/extension-underline": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "isbot": "^5",
    "jose": "^6.2.10",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.5.5",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.12",
    "husky": "^9.1.7",
    "knip": "^6.32.3",
    "prettier": "^3.9.6",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true
  }
}
