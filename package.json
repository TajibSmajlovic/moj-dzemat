{
  "name": "moj-dzemat",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight community publishing app for Bosnian-Herzegovinian d\u017eemats: public posts, admin panel, SQLite + Fly.io.",
  "license": "MIT",
  "author": "Tajib Smajlovi\u0107",
  "homepage": "https://github.com/TajibSmajlovic/moj-dzemat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TajibSmajlovic/moj-dzemat.git"
  },
  "bugs": {
    "url": "https://github.com/TajibSmajlovic/moj-dzemat/issues"
  },
  "imports": {
    "#app/*": "./app/*",
    "#generated/*": "./generated/*",
    "#prisma/*": "./prisma/*"
  },
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "build": "node --import tsx scripts/build.ts",
    "build:e2e": "node --import tsx scripts/build.ts --include-dev-routes",
    "pwa:icons": "node --import tsx scripts/pwa/generate-icons.ts",
    "start": "NODE_ENV=production node build/server-entry.mjs",
    "typecheck": "node --import tsx scripts/verify.ts types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node --import tsx scripts/checks/architecture.ts",
    "docs:check": "node --import tsx scripts/checks/docs.ts",
    "harness:check": "npm run docs:check && npm run architecture:check",
    "check": "node --import tsx scripts/verify.ts static",
    "check:staged": "node --import tsx/esm scripts/checks/staged.ts && npm run harness:check",
    "check:push": "node --import tsx scripts/verify.ts push",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node --import tsx scripts/run-e2e-tests.ts",
    "test:e2e:ui": "node --import tsx scripts/run-e2e-tests.ts --headed",
    "test:pwa": "node --import tsx scripts/pwa/run-tests.ts",
    "agent:start": "node --import tsx scripts/agent/runtime.ts start",
    "agent:logs": "node --import tsx scripts/agent/runtime.ts logs",
    "agent:stop": "node --import tsx scripts/agent/runtime.ts stop",
    "agent:verify": "node --import tsx scripts/agent/verify.ts",
    "agent:gc": "node --import tsx scripts/agent/maintenance.ts",
    "knip": "knip --treat-config-hints-as-errors",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset && prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:setup": "prisma migrate dev && prisma generate && prisma db seed",
    "postinstall": "react-router typegen && prisma generate",
    "prepare": "husky",
    "agent:smoke": "node --import tsx scripts/agent/smoke.ts",
    "storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
    "build:storybook": "storybook build --output-dir build/storybook --disable-telemetry",
    "test:storybook": "vitest run --config vitest.storybook.config.ts"
  },
  "dependencies": {
    "@conform-to/react": "^1.21.2",
    "@conform-to/zod": "^1.21.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@isaacs/ttlcache": "^2.1.4",
    "@mjackson/form-data-parser": "^0.9.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-router/express": "8.5.1",
    "@react-router/node": "8.5.1",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-typography": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "isbot": "^5",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "motion": "^14.13.0",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "semver": "^7.8.6",
    "storybook": "10.6.7",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true
  }
}
